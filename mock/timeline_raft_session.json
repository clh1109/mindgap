  "document": {
    "docId": "doc-raft-intro",
    "title": "Raft 共识算法入门",
    "appPackage": "com.example.reader",
    "totalChars": 5600,
    "paragraphs": [
      {
        "paragraphId": "p0",
        "index": 0,
        "heading": "引言",
        "charStart": 0,
        "charEnd": 520,
        "preview": "Raft 是一种用于管理复制日志的共识算法。它通过选举领导者、复制日志来让多个节点达成一致。"
      },
      {
        "paragraphId": "p1",
        "index": 1,
        "heading": "复制状态机",
        "charStart": 520,
        "charEnd": 1240,
        "preview": "每个服务器保存一份日志，按相同顺序执行相同命令，从而得到相同的状态机。"
      },
      {
        "paragraphId": "p2",
        "index": 2,
        "heading": "任期（Term）",
        "charStart": 1240,
        "charEnd": 1980,
        "preview": "Raft 把时间划分为任意长度的任期，任期用连续的整数编号。每个任期最多有一个领导者。",
        "terms": []
      },
      {
        "paragraphId": "p3",
        "index": 3,
        "heading": "领导者选举",
        "charStart": 1980,
        "charEnd": 2760,
        "preview": "候选人向其他节点发送 RequestVote，获得多数票即成为领导者。"
      },
      {
        "paragraphId": "p4",
        "index": 4,
        "heading": "日志复制",
        "charStart": 2760,
        "charEnd": 3580,
        "preview": "领导者通过 AppendEntries 复制日志，多数节点写入后更新 commit index。",
        "terms": [
          "commit index"
        ]
      },
      {
        "paragraphId": "p5",
        "index": 5,
        "heading": "日志匹配性质",
        "charStart": 3580,
        "charEnd": 4140,
        "preview": "若两条日志在相同索引处的任期相同，则它们之前的所有日志条目完全相同。",
        "terms": [
          "日志匹配性质",
          "前缀一致性"
        ]
      },
      {
        "paragraphId": "p6",
        "index": 6,
        "heading": "安全性约束",
        "charStart": 4140,
        "charEnd": 4890,
        "preview": "选举限制保证只有包含全部已提交日志的节点才能当选领导者。",
        "terms": [
          "选举限制"
        ]
      },
      {
        "paragraphId": "p7",
        "index": 7,
        "heading": "提交索引",
        "charStart": 4890,
        "charEnd": 5600,
        "preview": "commitIndex 之前的日志已被多数节点复制，可以安全地应用到状态机。",
        "terms": [
          "commitIndex"
        ]
      }
    ]
  },
